{
    "name": "Minesolver",

    "manifest_version": 3,
    "version": "1.0",
    "description": "To solve minesweeper",
    "action": {
        "default_popup": "popup_1.html",
        "default_icon": {
            "16": "icons/minesolver_16.png",
            "32": "icons/minesolver_32.png",
            "48": "icons/minesolver_48.png",
            "128": "icons/minesolver_128.png"
        }
    },
    "permissions": ["scripting", "activeTab", "tabs"],

    "content_scripts": [ 
        {
            "matches": ["https://www.google.com/search*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],

    "background": {
        "service_worker": "background.js"
    },

    "icons": {
        "16": "icons/minesolver_16.png",
        "32": "icons/minesolver_32.png",
        "48": "icons/minesolver_48.png",
        "128": "icons/minesolver_128.png"
    }
}
